# Copy to server/.env and adjust if your PostgreSQL differs from docker-compose.yml.
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inquirydesk
# Hosted PostgreSQL works too, e.g. Neon (pooled endpoint is fine; prefer sslmode=verify-full):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Used only by `npm test`. Must point at a database whose name ends in "_test":
# the test suite drops and recreates its schema.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/inquirydesk_test

# Signs session tokens. Required when NODE_ENV=production; a dev-only default is used otherwise.
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=8
